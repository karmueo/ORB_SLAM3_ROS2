+bool System::GetFinalOfflineSnapshot(std::vector<OfflineCameraPose>* poses,
+                                     std::vector<OfflineMapInfo>* maps,
+                                     std::string* errorMessage)
+{
+    if(!poses || !maps)
+    {
+        if(errorMessage) *errorMessage = "snapshot output pointers must not be null";
+        return false;
+    }
+    poses->clear();
+    maps->clear();
+
+    std::vector<Map*> allMaps = mpAtlas->GetAllMaps();
+    std::set<Map*> liveMaps;
+    std::map<unsigned long, std::size_t> mapIndex;
+    for(Map* pMap : allMaps)
+    {
+        if(!pMap)
+            continue;
+        liveMaps.insert(pMap);
+        OfflineMapInfo info;
+        info.id = pMap->GetId();
+        info.imuInitialized = pMap->isImuInitialized();
+        info.inertialBA1 = pMap->GetIniertialBA1();
+        info.inertialBA2 = pMap->GetIniertialBA2();
+        info.keyFrameCount = pMap->GetAllKeyFrames().size();
+        mapIndex[info.id] = maps->size();
+        maps->push_back(info);
+    }
+
+    std::set<std::int64_t> seenTimestamps;
+    for(const OfflineFrameRecord& record : mpTracker->mlOfflineFrameRecords)
+    {
+        if(!record.poseValid || !record.reference || record.timestampNs < 0)
+            continue;
+        if(seenTimestamps.count(record.timestampNs))
+            continue;
+
+        KeyFrame* pKF = record.reference;
+        Sophus::SE3f Trw;
+        int guard = 0;
+        while(pKF && pKF->isBad() && guard++ < 10000)
+        {
+            Trw = Trw * pKF->mTcp;
+            KeyFrame* pParent = pKF->GetParent();
+            if(pParent == pKF)
+            {
+                pKF = nullptr;
+                break;
+            }
+            pKF = pParent;
+        }
+        if(!pKF || pKF->isBad())
+            continue;
 
+        Map* pMap = pKF->GetMap();
+        if(!pMap || !liveMaps.count(pMap) || !pMap->isImuInitialized() || pMap->IsBad())
+            continue;
+
+        Trw = Trw * pKF->GetPose();
+        Sophus::SE3f Tcw = record.relativePose * Trw;
+        Sophus::SE3f Twc = Tcw.inverse();
+        if(!Twc.translation().allFinite() || !Twc.unit_quaternion().coeffs().allFinite())
+            continue;
+        Eigen::Quaternionf q = Twc.unit_quaternion();
+        const float norm = q.norm();
+        if(!std::isfinite(norm) || norm < 1e-8f)
+            continue;
+        q.normalize();
+
+        OfflineCameraPose pose;
+        pose.timestampNs = record.timestampNs;
+        pose.translation = Twc.translation();
+        pose.orientation = q;
+        pose.mapId = pMap->GetId();
+        pose.recentlyLost = record.recentlyLost;
+        poses->push_back(pose);
+        seenTimestamps.insert(record.timestampNs);
+
+        std::map<unsigned long, std::size_t>::const_iterator it = mapIndex.find(pose.mapId);
+        if(it != mapIndex.end())
+            ++((*maps)[it->second].exportedFrames);
+    }
 
+    std::sort(poses->begin(), poses->end(),
+              [](const OfflineCameraPose& a, const OfflineCameraPose& b) {
+                  if(a.timestampNs != b.timestampNs)
+                      return a.timestampNs < b.timestampNs;
+                  return a.mapId < b.mapId;
+              });
+    if(errorMessage) errorMessage->clear();
+    return true;
 }
 

+void LoopClosing::RequestStopGlobalBundleAdjustmentAndJoin()
+{
+    // Keep mMutexGBAThread held across stop+join+delete. Otherwise another
+    // caller can observe mpThreadGBA==NULL and start a new worker while the
+    // old worker is still running, sharing mbStopGBA and the same map.
+    unique_lock<mutex> workerLock(mMutexGBAThread);
+    thread* pWorker = mpThreadGBA;
+    mpThreadGBA = NULL;
+    if(pWorker)
+    {
+        {
+            unique_lock<mutex> lock(mMutexGBA);
+            mbStopGBA = true;
+            mnFullBAIdx++;
+        }
+        if(pWorker->joinable())
+            pWorker->join();
+        delete pWorker;
     }
 }
 
+void LoopClosing::StartGlobalBundleAdjustment(Map* pActiveMap, unsigned long nLoopKF)
+{
+    // Serialize worker replacement and creation. A new worker must not share
+    // mbStopGBA or map state with an old worker that is still joining.
+    unique_lock<mutex> workerLock(mMutexGBAThread);
+    if(mpThreadGBA)
+    {
+        thread* pOldWorker = mpThreadGBA;
+        mpThreadGBA = NULL;
+        {
+            unique_lock<mutex> lock(mMutexGBA);
+            mbStopGBA = true;
+            mnFullBAIdx++;
+        }
+        if(pOldWorker->joinable())
+            pOldWorker->join();
+        delete pOldWorker;
+    }
+
+    {
+        unique_lock<mutex> lock(mMutexGBA);
+        mbRunningGBA = true;
+        mbFinishedGBA = false;
+        mbStopGBA = false;
+        mnCorrectionGBA = mnNumCorrection;
+        mnFullBAIdx++;
+    }
+
+    thread* pWorker = new thread(&LoopClosing::RunGlobalBundleAdjustment, this, pActiveMap, nLoopKF);
+    mpThreadGBA = pWorker;
+}
+
+void LoopClosing::CompleteGlobalBundleAdjustment()
+{
+    unique_lock<mutex> lock(mMutexGBA);
+    mbFinishedGBA = true;
+    mbRunningGBA = false;
+}

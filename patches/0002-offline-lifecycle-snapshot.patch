+OfflineWaitStatus System::ShutdownOffline(std::string* reason)
+{
+    if(mbOfflineShutDown)
+    {
+        if(reason) reason->clear();
+        return OfflineWaitStatus::COMPLETE;
+    }
+
+    OfflineWaitStatus status = WaitForOfflineDrain(reason);
+
+    // Always join every worker before returning. If drain was interrupted or
+    // timed out the caller can still publish a clearly marked partial result.
+    JoinWorkerThreads(false, nullptr);
+    mbOfflineShutDown = true;
+    {
+        unique_lock<mutex> lock(mMutexReset);
+        mbShutDown = true;
+    }
+    return status;
+}

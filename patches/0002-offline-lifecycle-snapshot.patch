+OfflineWaitStatus System::WaitForLocalMappingReady(std::string* reason)
+{
+    const std::chrono::steady_clock::time_point start =
+        std::chrono::steady_clock::now();
+    while(true)
+    {
+        if(mpOfflineCancel && mpOfflineCancel->load())
+        {
+            if(reason) *reason = "cancelled while waiting for Local Mapping";
+            return OfflineWaitStatus::CANCELLED;
+        }
+        if(mbOfflineShutDown || mpLocalMapper->isFinished())
+        {
+            if(reason) *reason = "Local Mapping is finished";
+            return OfflineWaitStatus::UNAVAILABLE;
+        }
+        if(mpLocalMapper->HasBadImu())
+        {
+            // Let Tracking observe mbBadImu and perform the reset itself.
+            if(reason) *reason = "Local Mapping requested an active map reset";
+            return OfflineWaitStatus::READY;
+        }
+
+        const bool resetPending = mpLocalMapper->ResetPending() ||
+                                  mpLocalMapper->ResetActiveMapPending();
+        const bool queueEmpty = mpLocalMapper->KeyframesInQueue() == 0;
+        const bool accepting = mpLocalMapper->AcceptKeyFrames();
+        const bool stopped = mpLocalMapper->isStopped();
+        const bool stopRequested = mpLocalMapper->stopRequested();
+        const bool initializing = mpLocalMapper->IsInitializing();
+        if(!resetPending && queueEmpty && accepting && !stopped &&
+           !stopRequested && !initializing)
+        {
+            if(reason) reason->clear();
+            return OfflineWaitStatus::READY;
+        }
+
+        const long long elapsedMs =
+            std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - start).count();
+        if(mOfflineReadyTimeoutMs > 0 && elapsedMs >= mOfflineReadyTimeoutMs)
+        {
+            std::ostringstream out;
+            out << "Local Mapping not ready after " << elapsedMs
+                << " ms (queue=" << mpLocalMapper->KeyframesInQueue()
+                << ", accept=" << accepting << ", stopped=" << stopped
+                << ", stopRequested=" << stopRequested
+                << ", resetPending=" << resetPending
+                << ", initializing=" << initializing << ")";
+            if(reason) *reason = out.str();
+            return OfflineWaitStatus::TIMEOUT;
+        }
+        usleep(1000);
+    }
+}
+
+OfflineWaitStatus System::WaitForOfflineDrain(std::string* reason)
+{
+    const std::chrono::steady_clock::time_point start =
+        std::chrono::steady_clock::now();
+    const auto localIdle = [this]() -> bool {
+        return mpLocalMapper->KeyframesInQueue() == 0 &&
+               mpLocalMapper->AcceptKeyFrames() &&
+               !mpLocalMapper->isStopped() &&
+               !mpLocalMapper->stopRequested() &&
+               !mpLocalMapper->IsInitializing() &&
+               !mpLocalMapper->ResetPending() &&
+               !mpLocalMapper->ResetActiveMapPending();
+    };
+    const auto loopIdle = [this]() -> bool {
+        return mpLoopCloser->PendingKeyFrames() == 0 &&
+               !mpLoopCloser->IsProcessing() &&
+               !mpLoopCloser->isRunningGBA();
+    };
+    const auto describe = [this]() -> std::string {
+        std::ostringstream out;
+        out << "localQueue=" << mpLocalMapper->KeyframesInQueue()
+            << ", localAccept=" << mpLocalMapper->AcceptKeyFrames()
+            << ", localStopped=" << mpLocalMapper->isStopped()
+            << ", localStopRequested=" << mpLocalMapper->stopRequested()
+            << ", localInitializing=" << mpLocalMapper->IsInitializing()
+            << ", localResetPending=" << mpLocalMapper->ResetPending()
+            << ", localResetActiveMapPending="
+            << mpLocalMapper->ResetActiveMapPending()
+            << ", loopQueue=" << mpLoopCloser->PendingKeyFrames()
+            << ", loopProcessing=" << mpLoopCloser->IsProcessing()
+            << ", gbaRunning=" << mpLoopCloser->isRunningGBA();
+        return out.str();
+    };
+
+    while(true)
+    {
+        if(mpOfflineCancel && mpOfflineCancel->load())
+        {
+            if(reason) *reason = "cancelled while draining offline work";
+            return OfflineWaitStatus::INTERRUPTED;
+        }
+
+        const bool localReady = localIdle();
+        const bool loopReady = loopIdle();
+
+        if(mpLocalMapper->isFinished() || mpLoopCloser->isFinished())
+        {
+            // A worker that stopped early is not a successful drain. Only
+            // report COMPLETE when no queue/busy/reset/GBA work remains.
+            if(localReady && loopReady)
+            {
+                if(reason) reason->clear();
+                return OfflineWaitStatus::COMPLETE;
+            }
+            if(reason)
+                *reason = "worker thread finished before drain completed (" +
+                          describe() + ")";
+            return OfflineWaitStatus::UNAVAILABLE;
+        }
+
+        if(localReady && loopReady)
+        {
+            const unsigned long generation =
+                mpLocalMapper->GetWorkGeneration() + mpLoopCloser->GetWorkGeneration();
+            usleep(10000);
+            const bool stable =
+                localIdle() && loopIdle() &&
+                generation == (mpLocalMapper->GetWorkGeneration() +
+                               mpLoopCloser->GetWorkGeneration());
+            if(stable)
+            {
+                if(reason) reason->clear();
+                return OfflineWaitStatus::COMPLETE;
+            }
+        }
+
+        const long long elapsedMs =
+            std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - start).count();
+        if(mOfflineDrainTimeoutMs > 0 && elapsedMs >= mOfflineDrainTimeoutMs)
+        {
+            std::ostringstream out;
+            out << "offline drain timed out after " << elapsedMs
+                << " ms (" << describe() << ")";
+            if(reason) *reason = out.str();
+            return OfflineWaitStatus::TIMEOUT;
+        }
+        usleep(1000);
+    }
+}
